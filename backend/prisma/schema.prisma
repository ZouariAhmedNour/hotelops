generator client {
provider = "prisma-client-js"
}
datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}
model Role {
id Int @id @default(autoincrement())
name String @unique
code String @unique
description String?
users User[]
}
model User {
id Int @id @default(autoincrement())
firstName String
lastName String
email String @unique
passwordHash String
phone String?
roleId Int
isActive Boolean @default(true)
createdAt DateTime @default(now())
role Role @relation(fields: [roleId], references: [id])
reportedTickets MaintenanceTicket[] @relation("ReportedBy")
assignedTickets MaintenanceTicket[] @relation("AssignedTo")
comments MaintenanceComment[]
attachments MaintenanceAttachment[]
assignmentsGiven MaintenanceAssignment[] @relation("AssignedBy")
assignmentsReceived MaintenanceAssignment[] @relation("AssignedTo")
}
model Location {
id Int @id @default(autoincrement())

name String
type String
parentId Int?
hotelId Int?
code String? @unique
isActive Boolean @default(true)
parent Location? @relation("LocationTree", fields: [parentId], references:[id])
children Location[] @relation("LocationTree")
tickets MaintenanceTicket[]
}
model MaintenanceCategory {
id Int @id @default(autoincrement())
name String
description String?
icon String?
isActive Boolean @default(true)
tickets MaintenanceTicket[]
}
model MaintenancePriority {
id Int @id @default(autoincrement())
name String
code String @unique
sortOrder Int @default(0)
slaHours Int?
tickets MaintenanceTicket[]
}
model MaintenanceStatus {
id Int @id @default(autoincrement())
name String
code String @unique
color String?
isFinal Boolean @default(false)
tickets MaintenanceTicket[]
}
model MaintenanceTicket {
id Int @id @default(autoincrement())
ticketNumber String @unique
title String
description String
locationId Int
categoryId Int
priorityId Int
statusId Int

reportedByUserId Int
assignedToUserId Int?
reportedFrom String?
urgencyLevel Int?
dueAt DateTime?
resolvedAt DateTime?
closedAt DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
location Location @relation(fields: [locationId],references: [id])
category MaintenanceCategory @relation(fields: [categoryId],references: [id])
priority MaintenancePriority @relation(fields: [priorityId],references: [id])
status MaintenanceStatus @relation(fields: [statusId],references: [id])
reportedBy User @relation("ReportedBy", fields: [reportedByUserId],references: [id])
assignedTo User? @relation("AssignedTo", fields: [assignedToUserId],references: [id])
comments MaintenanceComment[]
attachments MaintenanceAttachment[]
assignments MaintenanceAssignment[]
}
model MaintenanceComment {
id Int @id @default(autoincrement())
ticketId Int
userId Int
comment String
isInternal Boolean @default(false)
createdAt DateTime @default(now())
ticket MaintenanceTicket @relation(fields: [ticketId], references: [id])
user User @relation(fields: [userId], references: [id])
}
model MaintenanceAttachment {
id Int @id @default(autoincrement())
ticketId Int
filePath String
fileName String
mimeType String
fileSize Int
uploadedByUserId Int
createdAt DateTime @default(now())
ticket MaintenanceTicket @relation(fields: [ticketId], references:[id])
uploadedBy User @relation(fields: [uploadedByUserId],references: [id])

}
model MaintenanceAssignment {
id Int @id @default(autoincrement())
ticketId Int
assignedToUserId Int
assignedByUserId Int
assignedAt DateTime @default(now())
unassignedAt DateTime?
note String?
ticket MaintenanceTicket @relation(fields: [ticketId], references:[id])
assignedTo User @relation("AssignedTo", fields: [assignedToUserId],references: [id])
assignedBy User @relation("AssignedBy", fields: [assignedByUserId],references: [id])
}