// prisma/schema.prisma
// ============================================================
// HotelOps — Schéma Prisma Unifié
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ROLES & UTILISATEURS
// ============================================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique // ADMIN | RECEPTION | CHEF_MAINT | MAINTENANCE_AGENT
  description String?

  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  roleId       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id])

  reportedTickets  MaintenanceTicket[] @relation("ReportedBy")
  assignedTickets  MaintenanceTicket[] @relation("AssignedTo")
  validatedTickets MaintenanceTicket[] @relation("ValidatedBy")

  comments    MaintenanceComment[]
  attachments MaintenanceAttachment[]

  assignmentsGiven    MaintenanceAssignment[] @relation("AssignedBy")
  assignmentsReceived MaintenanceAssignment[] @relation("AssignedTo")

  ticketEvents MaintenanceTicketEvent[]
  agentProfile MaintenanceAgentProfile?

  qrCodesCreated LocationQrCode[] @relation("QrCodeCreatedBy")

  serviceOrders        ServiceOrder[]        @relation("ServiceOrderUser")
  serviceOrderEvents   ServiceOrderEvent[]   @relation("ServiceOrderEventUser")
  serviceBookings      ServiceBooking[]      @relation("ServiceBookingUser")
  serviceBookingEvents ServiceBookingEvent[] @relation("ServiceBookingEventUser")
}

// ============================================================
// LOCALISATION
// 
// ============================================================

model Location {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  type  String // ROOM | FLOOR | COMMON_AREA | SERVICE_AREA | OUTDOOR | PARKING | OTHER
  zone  String? // Hébergement | Réception | Loisirs | Service | Extérieur
  floor String? // RDC | 1 | 2 | 3 | Sous-sol | Extérieur

  roomNumber  String?
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tickets        MaintenanceTicket[]
  qrCodes        LocationQrCode[]
  locationAssets LocationAsset[]
}

// ============================================================
// ÉQUIPEMENTS / ASSETS
// ============================================================

model MaintenanceAsset {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  category    String?
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationAssets LocationAsset[]
  ticketAssets   MaintenanceTicketAsset[]

  @@index([isActive])
  @@index([category])
}

model LocationAsset {
  id         Int      @id @default(autoincrement())
  locationId Int
  assetId    Int
  quantity   Int      @default(1)
  label      String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  asset    MaintenanceAsset @relation(fields: [assetId], references: [id])

  @@unique([locationId, assetId])
  @@index([locationId, isActive])
  @@index([assetId])
}

model MaintenanceTicketAsset {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  assetId   Int
  createdAt DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  asset  MaintenanceAsset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([ticketId, assetId])
  @@index([assetId])
}

// ============================================================
// CATÉGORIES, PRIORITÉS, STATUTS
// ============================================================

model MaintenanceCategory {
  id       Int     @id @default(autoincrement())
  name     String
  icon     String?
  isActive Boolean @default(true)

  tickets     MaintenanceTicket[]
  safetyRules MaintenanceSafetyRule[]
}

model MaintenancePriority {
  id        Int    @id @default(autoincrement())
  name      String
  code      String @unique // CRITICAL | HIGH | MEDIUM | LOW
  sortOrder Int    @default(0)
  slaHours  Int? // Délai SLA en heures

  tickets MaintenanceTicket[]
}

model MaintenanceStatus {
  id      Int     @id @default(autoincrement())
  name    String
  code    String  @unique
  color   String?
  isFinal Boolean @default(false)

  tickets MaintenanceTicket[]
}

// ============================================================
// TICKET PRINCIPAL
// ============================================================

model MaintenanceTicket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique
  title        String
  description  String

  locationId        Int
  categoryId        Int
  priorityId        Int
  statusId          Int
  reportedByUserId  Int?
  assignedToUserId  Int?
  validatedByUserId Int?

  publicReporterId Int?
  qrCodeId         Int?

  // Ticket de suivi créé depuis une intervention temporaire.
  parentTicketId Int?

  reportedFrom String? // mobile | web | reception | qr_public | agent_follow_up
  urgencyLevel Int?
  progress     Int     @default(0)

  dueAt       DateTime?
  acceptedAt  DateTime?
  startedAt   DateTime?
  pausedAt    DateTime?
  resolvedAt  DateTime?
  validatedAt DateTime?
  closedAt    DateTime?

  resolutionNote String?
  closureNote    String?
  pendingReason  String?
  needHelpReason String?

  // Résolution partielle / intervention lourde.
  temporaryFixNote           String?
  followUpReason             String?
  recommendedSpecialty       String?
  requiresExpertIntervention Boolean   @default(false)
  followUpCreatedAt          DateTime?

  timeSpentMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location            @relation(fields: [locationId], references: [id])
  category MaintenanceCategory @relation(fields: [categoryId], references: [id])
  priority MaintenancePriority @relation(fields: [priorityId], references: [id])
  status   MaintenanceStatus   @relation(fields: [statusId], references: [id])

  reportedBy     User?                 @relation("ReportedBy", fields: [reportedByUserId], references: [id])
  assignedTo     User?                 @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  validatedBy    User?                 @relation("ValidatedBy", fields: [validatedByUserId], references: [id])
  publicReporter PublicTicketReporter? @relation(fields: [publicReporterId], references: [id])
  qrCode         LocationQrCode?       @relation(fields: [qrCodeId], references: [id])

  // Self relation : ticket parent / tickets de suivi.
  parentTicket    MaintenanceTicket?  @relation("TicketFollowUps", fields: [parentTicketId], references: [id], onDelete: SetNull)
  followUpTickets MaintenanceTicket[] @relation("TicketFollowUps")

  comments     MaintenanceComment[]
  attachments  MaintenanceAttachment[]
  assignments  MaintenanceAssignment[]
  events       MaintenanceTicketEvent[]
  materials    MaintenanceInterventionMaterial[]
  ticketAssets MaintenanceTicketAsset[]

  riskAssessment MaintenanceTicketRiskAssessment?

  @@index([parentTicketId])
  @@index([requiresExpertIntervention])
  @@index([followUpCreatedAt])
}

// ============================================================
// COMMENTAIRES
// ============================================================

model MaintenanceComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  userId     Int
  comment    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id])
  user   User              @relation(fields: [userId], references: [id])
}

// ============================================================
// PIÈCES JOINTES
// ============================================================

model MaintenanceAttachment {
  id               Int    @id @default(autoincrement())
  ticketId         Int
  filePath         String
  fileName         String
  mimeType         String
  fileSize         Int
  uploadedByUserId Int?

  photoType String? // BEFORE | DURING | AFTER | PROOF
  caption   String?

  createdAt DateTime @default(now())

  ticket     MaintenanceTicket @relation(fields: [ticketId], references: [id])
  uploadedBy User?             @relation(fields: [uploadedByUserId], references: [id])
}

// ============================================================
// ASSIGNATIONS
// ============================================================

model MaintenanceAssignment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  assignedToUserId Int
  assignedByUserId Int
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  note             String?

  ticket     MaintenanceTicket @relation(fields: [ticketId], references: [id])
  assignedTo User              @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  assignedBy User              @relation("AssignedBy", fields: [assignedByUserId], references: [id])
}

// ============================================================
// TIMELINE DES ÉVÉNEMENTS
// ============================================================

model MaintenanceTicketEvent {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  userId       Int?
  type         String // CREATED | ASSIGNED | STATUS_CHANGED | RESOLVED | etc.
  fromStatusId Int?
  toStatusId   Int?
  message      String?
  metadata     Json?
  createdAt    DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id])
  user   User?             @relation(fields: [userId], references: [id])
}

// ============================================================
// MATÉRIAUX UTILISÉS EN INTERVENTION
// ============================================================

model MaintenanceInterventionMaterial {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  name      String
  quantity  Int      @default(1)
  unit      String?
  createdAt DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id])
}

// ============================================================
// ÉQUIPES & AGENTS
// ============================================================

model MaintenanceTeam {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents MaintenanceAgentProfile[]
}

model MaintenanceSkill {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  agents                 MaintenanceAgentSkill[]
  certificationLinks     MaintenanceCertificationSkill[]
  safetyRuleRequirements MaintenanceSafetyRuleSkillRequirement[]
}

model MaintenanceAgentProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  teamId             Int?
  employeeCode       String?  @unique
  level              String // JUNIOR | CONFIRMED | SENIOR | EXPERT
  shift              String // DAY | NIGHT | MORNING | AFTERNOON | ON_CALL
  availabilityStatus String   @default("AVAILABLE")
  mainSpecialty      String?
  canHandleCritical  Boolean  @default(false)
  maxActiveTickets   Int      @default(5)
  isOnCall           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id])
  team MaintenanceTeam? @relation(fields: [teamId], references: [id])

  skills         MaintenanceAgentSkill[]
  certifications MaintenanceAgentCertification[]
}

model MaintenanceAgentSkill {
  id             Int @id @default(autoincrement())
  agentProfileId Int
  skillId        Int
  level          Int @default(1)

  agentProfile MaintenanceAgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  skill        MaintenanceSkill        @relation(fields: [skillId], references: [id])

  @@unique([agentProfileId, skillId])
}

// ============================================================
// certification
// ============================================================
model MaintenanceCertification {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  code           String   @unique
  description    String?
  requiresExpiry Boolean  @default(false)
  validityMonths Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skillLinks             MaintenanceCertificationSkill[]
  agentCertifications    MaintenanceAgentCertification[]
  safetyRuleRequirements MaintenanceSafetyRuleCertificationRequirement[]
}

model MaintenanceCertificationSkill {
  id              Int @id @default(autoincrement())
  certificationId Int
  skillId         Int

  certification MaintenanceCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  skill         MaintenanceSkill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([certificationId, skillId])
}

model MaintenanceAgentCertification {
  id                Int       @id @default(autoincrement())
  agentProfileId    Int
  certificationId   Int
  issuedAt          DateTime?
  expiresAt         DateTime?
  provider          String?
  certificateNumber String?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agentProfile  MaintenanceAgentProfile  @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  certification MaintenanceCertification @relation(fields: [certificationId], references: [id])

  @@unique([agentProfileId, certificationId])
}

model MaintenanceSafetyRule {
  id                     Int      @id @default(autoincrement())
  name                   String
  code                   String   @unique
  description            String?
  categoryId             Int?
  triggerKeywords        String[] @default([])
  riskLevel              String
  riskScore              Int      @default(0)
  requiresCertifiedAgent Boolean  @default(false)
  minPriorityCode        String?
  minUrgencyLevel        Int?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  skillRequirements         MaintenanceSafetyRuleSkillRequirement[]
  certificationRequirements MaintenanceSafetyRuleCertificationRequirement[]
}

model MaintenanceSafetyRuleSkillRequirement {
  id           Int @id @default(autoincrement())
  safetyRuleId Int
  skillId      Int
  minimumLevel Int @default(1)

  safetyRule MaintenanceSafetyRule @relation(fields: [safetyRuleId], references: [id], onDelete: Cascade)
  skill      MaintenanceSkill      @relation(fields: [skillId], references: [id])

  @@unique([safetyRuleId, skillId])
}

model MaintenanceSafetyRuleCertificationRequirement {
  id              Int @id @default(autoincrement())
  safetyRuleId    Int
  certificationId Int

  safetyRule    MaintenanceSafetyRule    @relation(fields: [safetyRuleId], references: [id], onDelete: Cascade)
  certification MaintenanceCertification @relation(fields: [certificationId], references: [id])

  @@unique([safetyRuleId, certificationId])
}

model MaintenanceTicketRiskAssessment {
  id                         Int      @id @default(autoincrement())
  ticketId                   Int      @unique
  riskLevel                  String
  riskScore                  Int
  requiresCertifiedAgent     Boolean  @default(false)
  requiredSkillCodes         String[] @default([])
  requiredCertificationCodes String[] @default([])
  safetyReasons              String[] @default([])
  appliedRuleCodes           String[] @default([])
  evaluatedAt                DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================
// QR CODES
// ============================================================

model LocationQrCode {
  id         Int     @id @default(autoincrement())
  locationId Int
  token      String  @unique
  label      String?
  url        String
  isActive   Boolean @default(true)

  scanCount       Int       @default(0)
  lastScannedAt   DateTime?
  createdByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location  Location @relation(fields: [locationId], references: [id])
  createdBy User?    @relation("QrCodeCreatedBy", fields: [createdByUserId], references: [id])

  tickets MaintenanceTicket[]
}

model PublicTicketReporter {
  id Int @id @default(autoincrement())

  reporterType String // CLIENT | STAFF | VISITOR | OTHER | ANONYMOUS

  fullName        String?
  phone           String?
  email           String?
  roomNumber      String?
  reservationCode String?

  sourceIp  String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  tickets MaintenanceTicket[]
}

// ============================================================
// MODULE HOTEL SERVICES — TRONC COMMUN (CATALOGUE GÉNÉRIQUE)
// ============================================================

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  domain      String // ROOM_SERVICE | RESTAURANT | SPA | PLAYROOM | POOL | FITNESS | ACTIVITY | CONCIERGERIE
  icon        String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ServiceItem[]
  slots ServiceSlot[]

  @@index([domain])
  @@index([isActive])
}

model ServiceItem {
  id              Int      @id @default(autoincrement())
  categoryId      Int
  domain          String // dénormalisé depuis la catégorie
  name            String
  description     String?
  photos          String[] @default([])
  price           Decimal? @db.Decimal(10, 2)
  priceMin        Decimal? @db.Decimal(10, 2)
  priceMax        Decimal? @db.Decimal(10, 2)
  durationMinutes Int?
  prepTimeMinutes Int?
  allergens       String[] @default([])
  isAvailable     Boolean  @default(true)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ServiceCategory         @relation(fields: [categoryId], references: [id])
  options         ServiceItemOption[]
  supplements     ServiceItemSupplement[]
  slots           ServiceSlot[]
  orderLines      ServiceOrderLine[]
  bookings        ServiceBooking[]
  spaTreatment    SpaTreatment?
  restaurantTable RestaurantTable?

  @@index([categoryId])
  @@index([domain, isActive])
}

model ServiceItemOption {
  id         Int      @id @default(autoincrement())
  itemId     Int
  name       String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  item ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ServiceItemSupplement {
  id        Int      @id @default(autoincrement())
  itemId    Int
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  item ServiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ServiceSlot {
  id         Int      @id @default(autoincrement())
  itemId     Int?
  categoryId Int?
  dayOfWeek  Int
  startTime  String
  endTime    String
  capacity   Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  item     ServiceItem?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([categoryId])
}

// ============================================================
// MODULE HOTEL SERVICES — EXTENSION SPA
// ============================================================

model SpaTreatment {
  id                   Int      @id @default(autoincrement())
  itemId               Int      @unique
  genderPreference     String   @default("NO_PREFERENCE")
  allowTherapistChoice Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  item       ServiceItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  therapists SpaTreatmentTherapist[]

  @@index([genderPreference])
}

model SpaTherapist {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  gender    String
  photo     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments SpaTreatmentTherapist[]
  bookings   ServiceBooking[]

  @@index([gender, isActive])
}

model SpaTreatmentTherapist {
  id          Int @id @default(autoincrement())
  treatmentId Int
  therapistId Int

  treatment SpaTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  therapist SpaTherapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, therapistId])
  @@index([therapistId])
}

// ============================================================
// MODULE HOTEL SERVICES — EXTENSION RESTAURANT
// ============================================================

model RestaurantRoom {
  id       Int     @id @default(autoincrement())
  name     String
  code     String  @unique
  type     String
  capacity Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables RestaurantTable[]

  @@index([type, isActive])
}

model RestaurantTable {
  id        Int      @id @default(autoincrement())
  roomId    Int
  itemId    Int?     @unique
  name      String
  code      String   @unique
  seats     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room     RestaurantRoom   @relation(fields: [roomId], references: [id])
  item     ServiceItem?     @relation(fields: [itemId], references: [id])
  bookings ServiceBooking[]

  @@index([roomId])
}

// ============================================================
// MODULE HOTEL SERVICES — COMMANDES (ROOM SERVICE)
// ============================================================

model ServiceOrder {
  id            Int       @id @default(autoincrement())
  orderNumber   String    @unique
  domain        String    @default("ROOM_SERVICE")
  userId        Int?
  roomNumber    String?
  status        String    @default("NEW")
  totalAmount   Decimal   @default(0) @db.Decimal(10, 2)
  paymentMethod String?
  isPaid        Boolean   @default(false)
  comment       String?
  cancelReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  user   User?               @relation("ServiceOrderUser", fields: [userId], references: [id])
  lines  ServiceOrderLine[]
  events ServiceOrderEvent[]

  @@index([status])
  @@index([userId])
  @@index([domain])
}

model ServiceOrderLine {
  id            Int      @id @default(autoincrement())
  orderId       Int
  itemId        Int
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  optionIds     Int[]    @default([])
  supplementIds Int[]    @default([])
  comment       String?
  createdAt     DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  ServiceItem  @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
}

model ServiceOrderEvent {
  id         Int      @id @default(autoincrement())
  orderId    Int
  userId     Int?
  type       String
  fromStatus String?
  toStatus   String?
  message    String?
  createdAt  DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?        @relation("ServiceOrderEventUser", fields: [userId], references: [id])

  @@index([orderId])
}

// ============================================================
// MODULE HOTEL SERVICES — RÉSERVATIONS (RESTAURANT / SPA / LOISIRS)
// ============================================================

model ServiceBooking {
  id               Int       @id @default(autoincrement())
  bookingNumber    String    @unique
  domain           String
  itemId           Int?
  tableId          Int?
  therapistId      Int?
  userId           Int?
  roomNumber       String?
  bookingDate      DateTime
  startTime        String
  durationMinutes  Int?
  partySize        Int?
  genderPreference String?
  occasion         String?
  preferences      String?
  notes            String?
  status           String    @default("PENDING")
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  confirmedAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  item      ServiceItem?          @relation(fields: [itemId], references: [id])
  table     RestaurantTable?      @relation(fields: [tableId], references: [id])
  therapist SpaTherapist?         @relation(fields: [therapistId], references: [id])
  user      User?                 @relation("ServiceBookingUser", fields: [userId], references: [id])
  events    ServiceBookingEvent[]

  @@index([domain])
  @@index([status])
  @@index([bookingDate])
  @@index([userId])
}

model ServiceBookingEvent {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  userId     Int?
  type       String
  fromStatus String?
  toStatus   String?
  message    String?
  createdAt  DateTime @default(now())

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?          @relation("ServiceBookingEventUser", fields: [userId], references: [id])

  @@index([bookingId])
}
